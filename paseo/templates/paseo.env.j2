{{ ansible_managed | comment }}
# Daemon environment for paseo. Loaded by BOTH init systems — systemd via EnvironmentFile=, OpenRC
# by sourcing it in the service script — so OpenCode (and any MCP server Paseo launches) inherits
# these. They resolve the {env:VAR} placeholders in your sanitized opencode.json[c]. Managed by
# Ansible from paseo_opencode_secrets (Vault); mode 0640 root:paseo. Do NOT put PATH here.
#
# Single-quoted so the value is taken literally by both systemd and `.`-sourcing (no shell
# expansion). Single quotes inside a value are escaped '\''; avoid newlines in secret values.
{% for k, v in (paseo_opencode_secrets | dictsort) %}
{{ k }}='{{ v | string | replace("'", "'\\''") }}'
{% endfor %}
