{{ ansible_managed | comment }}
# Daemon environment for paseo. Loaded by BOTH init systems — systemd via EnvironmentFile=, OpenRC
# by sourcing it in the service script — so the agent CLIs Paseo launches (and any MCP server)
# inherit these. They resolve the {env:VAR} placeholders in your sanitized opencode.json[c], and
# carry ANTHROPIC_API_KEY for Claude Code. Managed by Ansible from paseo_opencode_secrets +
# paseo_claude_secrets (Vault), unioned in tasks/service.yml; mode 0640 root:paseo.
# Do NOT put PATH here — PATH is owned by the unit (see paseo_service_path).
#
# Single-quoted so the value is taken literally by both systemd and `.`-sourcing (no shell
# expansion). Single quotes inside a value are escaped '\''; avoid newlines in secret values.
{% for k, v in (_paseo_agent_secrets | dictsort) %}
{{ k }}='{{ v | string | replace("'", "'\\''") }}'
{% endfor %}
